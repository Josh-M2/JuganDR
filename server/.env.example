PORT=3101
HOST=127.0.0.1
CLIENT_URL=http://localhost:3102

# Run `pnpm run setup:admin` from the repository root to generate these.
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=

# Optional custom locations.
DATA_DIR=
CHROME_PATH=

# Neon deploy writes DATABASE_URL, DATABASE_URL_UNPOOLED, AWS_* and
# NEON_REALTIME_* to the ignored root .env.local automatically.
# Override only if you use a different private bucket.
ATTACHMENTS_BUCKET=jugan-request-attachments
